---
// AI:PAGE:BLOG_LIST — transformerWorker writes src/data/blog-data.ts; this
// page renders it using the Navbar/Footer blocks + real post thumbnails
// (ImageOrFallback — never the literal "Image" placeholder text).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/blocks/Navbar.astro';
import Footer from '../../components/blocks/Footer.astro';
import ImageOrFallback from '../../components/blocks/ImageOrFallback.astro';
import { blogData } from '../../data/blog-data';

const posts = blogData.posts;
---

<BaseLayout title={blogData.title} description={blogData.subtitle}>
  <Navbar slot="navbar" props={{ logo: 'Logo', links: blogData.navLinks }} />

  <div class="h-16"></div>

  <section class="py-20 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-4xl md:text-6xl font-bold text-foreground text-balance">{blogData.title}</h1>
      <p class="mt-4 text-xl text-muted-foreground text-pretty">{blogData.subtitle}</p>
    </div>
  </section>

  <section class="pb-24 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <article class="group flex flex-col bg-card rounded-xl overflow-hidden border border-border hover:border-primary/30 transition-colors duration-200">
            <div class="aspect-[16/9]">
              <ImageOrFallback image={post.image ? { ...post.image, alt: post.image.alt || post.title } : { alt: post.title }} />
            </div>
            <div class="flex flex-col flex-1 p-6">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-xs font-medium text-primary bg-primary/10 px-2 py-1 rounded-full">
                  {post.category}
                </span>
                <time class="text-xs text-muted-foreground tabular-nums" datetime={post.date}>
                  {new Date(post.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                </time>
              </div>
              <h2 class="text-xl font-semibold text-foreground text-balance mb-2 group-hover:text-primary transition-colors">
                {post.title}
              </h2>
              <p class="text-muted-foreground text-sm leading-relaxed flex-1 text-pretty">
                {post.excerpt}
              </p>
              <a
                href={`/blog/${post.slug}`}
                class="mt-4 inline-flex items-center text-primary text-sm font-medium hover:underline focus-visible:ring-2 focus-visible:ring-primary rounded"
                aria-label={`Read more about ${post.title}`}
              >
                Read more
                <svg class="ml-1 w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" props={{ copyright: `© ${new Date().getFullYear()}`, links: [] }} />
</BaseLayout>
