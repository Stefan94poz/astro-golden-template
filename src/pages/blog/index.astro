---
// AI:PAGE:BLOG_LIST — Blog list template for transformerWorker injection
// transformerWorker Step 4 writes src/data/blog-data.ts; this page renders it.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogData } from '../../data/blog-data';

const posts = blogData.posts;
---

<BaseLayout
  title={blogData.title}
  description={blogData.subtitle}
>
  <!-- AI:INJECT:NAVBAR -->
  <nav slot="navbar" class="fixed top-0 w-full z-50 bg-background/90 backdrop-blur-sm border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="font-bold text-xl text-primary" aria-label="Home">Logo</a>
      <div class="hidden md:flex items-center gap-8">
        <!-- AI:INJECT:NAV_LINKS -->
      </div>
    </div>
  </nav>

  <div class="h-16"></div>

  <!-- Blog header -->
  <section class="py-20 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-4xl md:text-6xl font-bold text-foreground text-balance">
        <!-- AI:INJECT:BLOG_TITLE -->
        {blogData.title}
      </h1>
      <p class="mt-4 text-xl text-muted-foreground text-pretty">
        <!-- AI:INJECT:BLOG_SUBTITLE -->
        {blogData.subtitle}
      </p>
    </div>
  </section>

  <!-- Blog posts grid -->
  <section class="pb-24 px-4">
    <div class="max-w-7xl mx-auto">
      <!-- SANITY: Replace this placeholder grid with Sanity content query -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <article class="group flex flex-col bg-card rounded-xl overflow-hidden border border-border hover:border-primary/30 transition-colors duration-200">
            <!-- Thumbnail placeholder -->
            <div class="aspect-[16/9] bg-primary/5 flex items-center justify-center">
              <span class="text-muted-foreground text-sm" aria-hidden="true">Image</span>
            </div>
            <div class="flex flex-col flex-1 p-6">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-xs font-medium text-primary bg-primary/10 px-2 py-1 rounded-full">
                  {post.category}
                </span>
                <time class="text-xs text-muted-foreground tabular-nums" datetime={post.date}>
                  {new Date(post.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                </time>
              </div>
              <h2 class="text-xl font-semibold text-foreground text-balance mb-2 group-hover:text-primary transition-colors">
                {post.title}
              </h2>
              <p class="text-muted-foreground text-sm leading-relaxed flex-1 text-pretty">
                {post.excerpt}
              </p>
              <a
                href={`/blog/${post.slug}`}
                class="mt-4 inline-flex items-center text-primary text-sm font-medium hover:underline focus-visible:ring-2 focus-visible:ring-primary rounded"
                aria-label={`Read more about ${post.title}`}
              >
                Read more
                <svg class="ml-1 w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Pagination — SANITY: Connect to real page count -->
      <nav class="mt-16 flex justify-center items-center gap-2" aria-label="Blog pagination">
        <button
          disabled
          class="px-4 py-2 text-sm rounded-lg border border-border text-muted-foreground cursor-not-allowed"
          aria-label="Previous page"
        >
          Previous
        </button>
        <span class="px-4 py-2 text-sm font-medium text-primary bg-primary/10 rounded-lg" aria-current="page">
          1
        </span>
        <button
          class="px-4 py-2 text-sm rounded-lg border border-border text-foreground hover:bg-card transition-colors focus-visible:ring-2 focus-visible:ring-primary"
          aria-label="Next page"
        >
          Next
        </button>
      </nav>
    </div>
  </section>

  <!-- Footer -->
  <footer slot="footer" class="py-12 px-4 border-t border-border">
    <div class="max-w-7xl mx-auto text-center text-muted-foreground text-sm">
      <!-- AI:INJECT:FOOTER_CONTENT -->
      © {new Date().getFullYear()} Company Name
    </div>
  </footer>
</BaseLayout>
