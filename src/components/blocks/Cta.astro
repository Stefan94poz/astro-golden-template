---
// Cta.astro — variant: centered | split-image
// "split-image" fixes the old "center image in cta" bug: the image now has
// a real, dedicated column instead of being force-centered raw HTML.
import type { CtaProps } from '../../lib/blocks';
import ImageOrFallback from './ImageOrFallback.astro';

export interface Props {
  variant?: string;
  props: CtaProps;
}

const { variant = 'centered', props } = Astro.props;
const { title, subtitle, ctas = [], image } = props;
---

{variant === 'split-image' ? (
  <section class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto rounded-2xl overflow-hidden border border-border bg-card grid grid-cols-1 md:grid-cols-2 items-stretch">
      <div class="p-10 md:p-14 flex flex-col justify-center">
        <h2 class="text-3xl md:text-4xl font-bold text-foreground text-balance mb-4">{title}</h2>
        {subtitle && <p class="text-lg text-muted-foreground mb-8 text-pretty">{subtitle}</p>}
        {ctas.length > 0 && (
          <div class="flex flex-wrap gap-4">
            {ctas.map((cta) => (
              <a href={cta.href} class="px-6 py-3 rounded-md bg-primary text-primary-foreground text-sm font-medium hover:opacity-90 transition-opacity focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
                {cta.label}
              </a>
            ))}
          </div>
        )}
      </div>
      <div class="aspect-[4/3] md:aspect-auto">
        <ImageOrFallback image={image} />
      </div>
    </div>
  </section>
) : (
  <section class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center bg-primary/5 rounded-2xl p-12 md:p-16 border border-primary/20">
      <h2 class="text-3xl md:text-4xl font-bold text-foreground text-balance mb-4">{title}</h2>
      {subtitle && <p class="text-lg text-muted-foreground mb-8 max-w-xl mx-auto text-pretty">{subtitle}</p>}
      {ctas.length > 0 && (
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          {ctas.map((cta) => (
            <a href={cta.href} class="px-6 py-3 rounded-md bg-primary text-primary-foreground text-sm font-medium hover:opacity-90 transition-opacity focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
              {cta.label}
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
)}
