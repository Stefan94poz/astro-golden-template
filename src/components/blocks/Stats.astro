---
// Stats.astro — variant: band
import type { StatsProps } from '../../lib/blocks';

export interface Props {
  variant?: string;
  props: StatsProps;
}

const { props } = Astro.props;
const { title, items = [] } = props;
---

<section class="py-16 px-4 sm:px-6 lg:px-8 bg-card border-y border-border">
  <div class="max-w-6xl mx-auto">
    {title && <h2 class="text-2xl md:text-3xl font-bold text-foreground text-balance text-center mb-12">{title}</h2>}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      {items.map((stat) => (
        <div>
          <p class="text-3xl md:text-5xl font-bold text-primary tabular-nums">{stat.value}</p>
          <p class="mt-2 text-sm text-muted-foreground">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
