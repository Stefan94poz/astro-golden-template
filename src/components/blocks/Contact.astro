---
// Contact.astro — variant: centered | split
import type { ContactProps } from '../../lib/blocks';
import ImageOrFallback from './ImageOrFallback.astro';

export interface Props {
  variant?: string;
  props: ContactProps;
}

const { variant = 'centered', props } = Astro.props;
const { title, description, email, phone, address, image } = props;
---

{variant === 'split' ? (
  <section class="py-20 px-4 sm:px-6 lg:px-8 bg-card">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
      <div class="rounded-2xl overflow-hidden aspect-[4/3] border border-border">
        <ImageOrFallback image={image} />
      </div>
      <div>
        {title && <h2 class="text-3xl md:text-4xl font-bold text-foreground text-balance mb-4">{title}</h2>}
        {description && <p class="text-lg text-muted-foreground mb-6 text-pretty">{description}</p>}
        <div class="flex flex-col gap-2">
          {email && <a href={`mailto:${email}`} class="text-primary hover:underline focus-visible:ring-2 focus-visible:ring-primary rounded">{email}</a>}
          {phone && <a href={`tel:${phone}`} class="text-primary hover:underline focus-visible:ring-2 focus-visible:ring-primary rounded">{phone}</a>}
          {address && <address class="text-muted-foreground not-italic text-sm">{address}</address>}
        </div>
      </div>
    </div>
  </section>
) : (
  <section class="py-20 px-4 sm:px-6 lg:px-8 bg-card">
    <div class="max-w-2xl mx-auto text-center">
      {title && <h2 class="text-3xl md:text-4xl font-bold text-foreground text-balance mb-4">{title}</h2>}
      {description && <p class="text-lg text-muted-foreground mb-8 text-pretty">{description}</p>}
      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
        {email && <a href={`mailto:${email}`} class="text-primary hover:underline focus-visible:ring-2 focus-visible:ring-primary rounded">{email}</a>}
        {phone && <a href={`tel:${phone}`} class="text-primary hover:underline focus-visible:ring-2 focus-visible:ring-primary rounded">{phone}</a>}
        {address && <address class="text-muted-foreground not-italic text-sm">{address}</address>}
      </div>
    </div>
  </section>
)}
