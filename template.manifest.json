{
  "$schema": "./template.manifest.schema.json",
  "version": "2.0.0",
  "description": "Contract between astro-golden-template and transformerWorker (v2 — block-based layout composition). The worker's Layout Planner emits an ordered BlockInstance[] plan; the Block Content Filler fills each block's typed props; PageAssembler.astro renders the plan. There is no fixed page skeleton — the worker never writes raw markup.",
  "astro": ">=7.1",
  "tailwind": ">=4.0",
  "architecture": "block-composition",
  "blocks": {
    "registryFile": "src/lib/blocks.ts",
    "componentDir": "src/components/blocks",
    "assembler": "src/layouts/PageAssembler.astro",
    "types": [
      "navbar", "hero", "features", "gallery", "stats", "logo-cloud",
      "testimonials", "news-list", "cta", "prose", "contact", "footer"
    ]
  },
  "pages": {
    "home": {
      "astroFile": "src/pages/index.astro",
      "dataFile": "src/data/pages/home.ts",
      "dataExport": "homeBlocks"
    },
    "genericContent": {
      "dataFileDir": "src/data/pages",
      "dataExportSuffix": "Blocks",
      "note": "Worker writes one <slug>.ts data file + one thin <slug>.astro wrapper per non-home page. Both files follow the same pattern as src/pages/index.astro."
    },
    "blogList": {
      "file": "src/pages/blog/index.astro",
      "marker": "AI:PAGE:BLOG_LIST",
      "dataFile": "src/data/blog-data.ts"
    },
    "blogDetail": {
      "file": "src/pages/blog/[slug].astro",
      "marker": "AI:PAGE:BLOG_DETAIL",
      "dataFile": "src/data/blog-data.ts"
    }
  },
  "layout": {
    "file": "src/layouts/BaseLayout.astro",
    "marker": "AI:LAYOUT:BASE",
    "slots": [
      "AI:INJECT:FONT_PRELOADS"
    ]
  },
  "brandOverrides": {
    "file": "src/styles/brand-overrides.css",
    "importedAfter": "src/styles/starwind.css",
    "variables": [
      "--primary",
      "--primary-foreground",
      "--primary-accent",
      "--secondary",
      "--secondary-foreground",
      "--secondary-accent",
      "--accent",
      "--accent-foreground",
      "--background",
      "--foreground",
      "--card",
      "--card-foreground",
      "--popover",
      "--popover-foreground",
      "--muted",
      "--muted-foreground",
      "--border",
      "--input",
      "--font-sans",
      "--font-heading"
    ]
  },
  "fontVariables": ["--font-sans", "--font-heading"],
  "images": {
    "publicDir": "public",
    "note": "All downloaded assets live flat under /public. Blocks reference them via ImageRef.src (e.g. '/hero-photo.jpg'). ImageOrFallback.astro renders a graceful placeholder when src is absent — an image slot is never left blank."
  }
}
